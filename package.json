{
  "name": "the-shape-of-music",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Make music by drawing shapes",
  "author": "Elias Jarzombek",
  "contributors": [
    "Shawn Ormond <sormond@gmail.com> (fork maintainer, https://github.com/sormondocom/the-shape-of-music)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sormondocom/the-shape-of-music.git"
  },
  "keywords": [
    "music",
    "shapes",
    "polygons",
    "web audio",
    "geometry"
  ],
  "private": false,
  "bin": {
    "shape-line-art": "scripts/exportLineArt.js"
  },
  "dependencies": {
    "@ant-design/icons": "^4.3.0",
    "@craco/craco": "^6.0.0",
    "@sentry/browser": "^5.0.8",
    "@tonejs/midi": "^2.0.28",
    "antd": "4",
    "bufferutil": "^4.0.1",
    "chalk": "^2.4.2",
    "classnames": "^2.2.5",
    "color": "^2.0.1",
    "craco-antd": "^2.0.0",
    "date-fns": "^2.0.1",
    "file-saver": "2.0.0",
    "inline-worker": "1.1.0",
    "js-levenshtein": "^1.1.6",
    "jszip": "3.7.0",
    "konva": "^6.0.0",
    "lamejs": "^1.2.1",
    "lodash": "^4.17.21",
    "midi-writer-js": "1.5.2",
    "prop-types": "^15.6.0",
    "radium": "^0.24.0",
    "rc-slider": "^8.6.1",
    "react": "^16.13.1",
    "react-color": "^2.14.0",
    "react-dom": "^16.13.1",
    "react-draggable": "^3.0.3",
    "react-full-screen": "0.0.2",
    "react-fullscreenable": "^2.5.0",
    "react-hotkeys": "^2.0.0",
    "react-konva": "^16.13.0-3",
    "react-portal": "^3.2.0",
    "react-router": "^5.0.0",
    "react-router-dom": "^5.0.0",
    "react-scripts": "5",
    "react-select": "^3.0.8",
    "spessasynth_core": "4.4.4",
    "spessasynth_lib": "^4.4.2",
    "teoria": "^2.5.0",
    "tone": "13.8.25",
    "utf-8-validate": "^5.0.2",
    "vexflow": "^5.0.0"
  },
  "scripts": {
    "line-art": "node ./scripts/exportLineArt.js",
    "start": "craco start",
    "start:app": "craco start",
    "build": "craco build && yarn append-sw",
    "build:app": "craco build",
    "append-sw": "cat src/sw-epilog.js >> build/service-worker.js",
    "test": "craco test --env=jsdom",
    "eject": "react-scripts eject"
  },
  "devDependencies": {
    "@babel/register": "^7.22.0",
    "eslint-plugin-jasmine": "^2.10.1",
    "eslint-plugin-prettier": "^2.6.2",
    "npm-run-all": "^4.1.5",
    "prettier": "^1.16.1"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
